<section class="wrap shop-page narrow" style="text-align:center;min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:20px">
<div class="hero-art" style="width:min(280px,70%)" aria-hidden="true">{% render 'art-bee' %}</div>
<h1 class="page-title">{{ shop.name }}</h1>
<p class="muted">{{ section.settings.text }}</p>
{%- form 'customer', class: 'join-form' -%}
<input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
{%- if form.posted_successfully? -%}<p class="form-note" role="status">You’re on the list!</p>{%- else -%}
<label for="pw-em" class="sr-only">Email address</label>
<input id="pw-em" class="field" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required style="flex:1;min-width:200px">
<button class="btn btn-d" type="submit">Notify me</button>
{%- endif -%}
{%- endform -%}
<details class="pw-details">
<summary class="muted">Store owner? Enter password</summary>
{%- form 'storefront_password', class: 'join-form' -%}
{%- if form.errors %}<p class="form-note" role="alert">{{ form.errors | default_errors }}</p>{% endif -%}
<label for="pw" class="sr-only">Password</label>
<input id="pw" class="field" type="password" name="password" placeholder="Password" required style="flex:1;min-width:200px">
<button class="btn btn-l" type="submit">Enter</button>
{%- endform -%}
</details>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Text", "default": "Something lovely is on the way. Leave your email and be first in the hive." }
  ]
}
{% endschema %}
