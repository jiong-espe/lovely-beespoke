<section class="wrap shop-page">
<h1 class="page-title">All <em>collections</em></h1>
<div class="product-grid">
{%- for c in collections -%}
<a class="card-p" href="{{ c.url }}">
<div class="card-img">{% if c.featured_image %}{{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 900px) 25vw, 50vw', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div>
<div class="card-t">{{ c.title }}</div>
<div class="card-price muted">{{ c.products_count }} pieces</div>
</a>
{%- endfor -%}
</div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
