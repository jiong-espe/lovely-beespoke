{%- comment -%} Pillars landscape; the sun shows each slide's image (block image, else the collection's featured image). Expects `section`. {%- endcomment -%}
<svg viewBox="0 0 800 500" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="#2B2629" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
<rect x="-400" width="1200" height="500" fill="#DCCFE3" stroke="none"/>
<circle class="sun" cx="620" cy="150" r="72" stroke="none"/>
<circle class="ring" cx="620" cy="150" r="86" stroke-dasharray="2 7"/>
<text class="art-label" data-label x="620" y="146" text-anchor="middle" stroke="none">[PRODUCT<tspan x="620" dy="18">PHOTO]</tspan></text>
<defs><clipPath id="sun-clip"><circle cx="620" cy="150" r="72"/></clipPath></defs>
{%- for block in section.blocks -%}
{%- assign img = block.settings.image | default: block.settings.collection.featured_image -%}
{%- if img != blank -%}<image class="sun-img{% if forloop.first %} on{% endif %}" data-sun-img data-i="{{ forloop.index0 }}" href="{{ img | image_url: width: 400 }}" x="548" y="78" width="144" height="144" preserveAspectRatio="xMidYMid slice" clip-path="url(#sun-clip)"/>{%- endif -%}
{%- endfor %}
