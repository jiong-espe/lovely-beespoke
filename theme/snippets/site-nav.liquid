{%- comment -%} Brand + main menu + cart. Falls back to the home-page anchors until a "main-menu" menu has links. {%- endcomment -%}
<div class="wrap site-nav">
<a href="{{ routes.root_url }}" class="site-brand">
<svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="#2B2629" stroke-width="1.6" aria-hidden="true"><ellipse cx="20" cy="24" rx="9" ry="7" fill="#F2C14E"/><path d="M15 20v8M20 17.5v13M25 20v8"/><circle cx="20" cy="14" r="3.5"/><path d="M15 17C9 7 12 5 16 9M25 17C31 7 28 5 24 9"/></svg>
<span>{{ shop.name }}</span>
</a>
<nav class="nav-links" aria-label="Main">
{%- if linklists['main-menu'].links.size > 0 -%}
{%- for link in linklists['main-menu'].links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
{%- else -%}
<a href="{{ routes.root_url }}#shop">Shop</a><a href="{{ routes.root_url }}#ritual">How it’s made</a><a href="{{ routes.root_url }}#bea">Ask Bea</a>
{%- endif -%}
</nav>
<a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2B2629" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
{%- if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif -%}
</a>
</div>
